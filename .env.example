# No environment file is required for the bundled examples/web library.
# Optional: override it with a directory on the server (absolute path).
# SCRATCH_EXAMPLES_DIR=/absolute/path/to/custom/examples
# Set SCRATCH_EXAMPLES_DIR= explicitly to disable the gallery.
SCRATCH_EXAMPLES_MAX_MB=50
SCRATCH_EXAMPLES_RECURSIVE=false

# Production: exact trusted hostname(s), comma-separated, no scheme/port/wildcards.
# Localhost/127.0.0.1/[::1] are always allowed.
# SCRATCH_ALLOWED_HOSTS=scratch.example.com
